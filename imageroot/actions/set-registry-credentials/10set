#!/usr/bin/env python3
#
# Azione set-registry-credentials: memorizza per QUESTA istanza le
# credenziali usate dalle chiamate HTTP dirette a ghcr.io (check-update,
# configure-module) per leggere l'elenco dei tag dell'immagine
# applicativa privata (pubblicata da una pipeline esterna, non da questo
# modulo - vedi guida §3.16/3.17). Da invocare UNA TANTUM per istanza,
# SOLO da terminale (mai dalla UI cluster-admin: è un credenziale interno
# di Startapp, non un dato che il cliente deve vedere o gestire):
#
#   api-cli run module/<id>/set-registry-credentials \
#       -d '{"username": "<utente-o-bot-github>", "token": "<PAT-con-scope-read:packages>"}'
#
# Il PAT va digitato solo al momento dell'esecuzione di questo comando sul
# terminale del server, mai incollato altrove (chat, ticket, ecc.): se è
# mai finito da qualche parte fuori dal terminale, va revocato e
# rigenerato prima di riusarlo qui.
#
# IMPORTANTE - cosa questa azione NON fa (e perché): non esegue un
# "podman login" contro il file di autenticazione registri del NODO
# (/etc/nethserver/registry.json, impostato come REGISTRY_AUTH_FILE per
# ogni azione da /etc/nethserver/agent.env). Quel file e' condiviso da
# TUTTI i moduli installati sul nodo (mariadb, altri moduli applicativi,
# il mirror ghcr.io/nethserver/docker.io usato per le immagini docker.io
# di sistema, ecc.): scriverci un login generico per l'intero host
# "ghcr.io" rischierebbe di alterare l'autenticazione usata da pull
# completamente estranei a questo modulo. Un'azione eseguita come utente
# di sistema non privilegiato del modulo (es. sentinel-fornitori6) non
# avrebbe comunque i permessi per scriverci (e' di proprieta' di root),
# ma anche potendo, non lo faremmo: è deliberatamente fuori portata.
#
# Al suo posto, questa azione scrive un file di credenziali DEDICATO A
# QUESTA SOLA ISTANZA, dentro la home del modulo (dove l'utente non
# privilegiato ha gia' pieni permessi, nessun bisogno di root), con
# un'unica voce vincolata (namespaced, non l'intero host) al solo
# repository dell'immagine applicativa privata. update-now/configure-
# module passano questo file esplicitamente a "podman pull" con
# --authfile, bypassando cosi' del tutto il file condiviso del nodo:
# zero rischio per qualunque altro modulo o pull sullo stesso host.

import base64
import json
import os
import sys

import agent

APP_IMAGE_REPO_PATH = "ghcr.io/startappate/sentinel-fornitori-nis2"
GHCR_AUTHFILE = os.path.expanduser("~/.config/state/ghcr-pull-auth.json")

request = json.load(sys.stdin)
username = request["username"]
token = request["token"]

agent.set_env("GHCR_PULL_USER", username)
agent.set_env("GHCR_PULL_TOKEN", token)

os.makedirs(os.path.dirname(GHCR_AUTHFILE), exist_ok=True)
auth_b64 = base64.b64encode(f"{username}:{token}".encode()).decode()
with open(GHCR_AUTHFILE, "w") as f:
    json.dump({"auths": {APP_IMAGE_REPO_PATH: {"auth": auth_b64}}}, f)
os.chmod(GHCR_AUTHFILE, 0o600)

print(json.dumps({"status": "ok"}))
