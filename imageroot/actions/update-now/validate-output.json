{
    "$schema": "http://json-schema.org/draft-07/schema#",
    "title": "update-now output",
    "$id": "http://schema.nethserver.org/sentinel-fornitori/update-now-output.json",
    "description": "Esito dell'aggiornamento dell'immagine applicativa (solo il caso di successo: un fallimento con rollback termina l'azione con exit diverso da zero)",
    "examples": [
        { "status": "ok", "installed_version": "1.1.0" }
    ],
    "type": "object",
    "properties": {
        "status": { "type": "string", "enum": ["ok"] },
        "installed_version": { "type": "string" }
    },
    "required": ["status", "installed_version"],
    "additionalProperties": false
}
