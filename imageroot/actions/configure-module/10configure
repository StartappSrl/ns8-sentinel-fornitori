#!/usr/bin/env python3
#
# Azione configure-module: valida l'input ricevuto dalla cluster-admin (o da
# CLI) e persiste la configurazione dell'installazione SENTINEL Fornitori.

import agent
import agent.tasks
import json
import os
import sys
import secrets

request = json.load(sys.stdin)

domain = request.get("domain")              # es. fornitori.cliente.it
customer_name = request.get("customer_name")
installation_id = request.get("installation_id")
admin_email = request.get("admin_email")
admin_password = request.get("admin_password")

if not domain:
    sys.exit(1)  # dominio obbligatorio

tcp_ports = [p.strip() for p in os.environ["TCP_PORTS"].split(",")]
tcp_port, postgres_port, minio_port, clamav_port = tcp_ports

postgres_db = "sentinel"
postgres_user = "sentinel"
postgres_password = secrets.token_hex(32)
minio_bucket = "sentinel-evidence"

# I 4 container del modulo (postgres/minio/clamav/app) sono tutti sulla
# stessa rete Podman dedicata "sentinel-net" (creata da ogni unit systemd
# con "podman network create --ignore" in ExecStartPre, idempotente), con
# un alias DNS per servizio uguale al nome usato in compose.yml originale
# (postgres/minio/clamav) - cosi' l'app si connette con GLI STESSI hostname
# del pacchetto Docker Compose, non con 127.0.0.1.
env = {
    "RUNTIME_MODE": "docker",
    "APP_VERSION": os.environ.get("APP_VERSION", "1.0.0"),
    "APP_DOMAIN": domain,
    "CUSTOMER_NAME": customer_name or "",
    "INSTALLATION_ID": installation_id or "",
    "DEPLOYMENT_ENV": "production",
    "ENABLED_MODULES": "NIS2",
    "AUTH_MODE": "local",
    "SESSION_SECRET": secrets.token_hex(48),
    "SESSION_MAX_AGE_SECONDS": "28800",
    "COOKIE_SECURE": "true",
    "TCP_PORT": str(tcp_port),
    "POSTGRES_TCP_PORT": str(postgres_port),
    "MINIO_TCP_PORT": str(minio_port),
    "CLAMAV_TCP_PORT": str(clamav_port),
    "POSTGRES_DB": postgres_db,
    "POSTGRES_USER": postgres_user,
    "POSTGRES_PASSWORD": postgres_password,
    "DATABASE_URL": f"postgresql://{postgres_user}:{postgres_password}@postgres:5432/{postgres_db}",
    "DATABASE_POOL_SIZE": "10",
    "MINIO_ENDPOINT": "minio",
    "MINIO_PORT": "9000",
    "MINIO_USE_SSL": "false",
    "MINIO_ROOT_USER": "sentinel-storage",
    "MINIO_ROOT_PASSWORD": secrets.token_hex(32),
    "MINIO_BUCKET": minio_bucket,
    "CLAMAV_ENABLED": "true",
    "CLAMAV_HOST": "clamav",
    "CLAMAV_PORT": "3310",
    "CLAMAV_TIMEOUT_MS": "120000",
    "ADMIN_EMAIL": admin_email or "",
    "ADMIN_PASSWORD": admin_password or secrets.token_urlsafe(24),
    "ADMIN_NAME": "Amministratore",
}

for key, value in env.items():
    agent.set_env(key, value)

agent.run_helper("systemctl", "--user", "daemon-reload")
for unit in (
    "sentinel-postgres.service",
    "sentinel-minio.service",
    "sentinel-clamav.service",
    "sentinel-app.service",
):
    agent.run_helper("systemctl", "--user", "enable", "--now", unit)

app_image = os.environ.get("SENTINEL_FORNITORI_APP_IMAGE", "")
state_env_file = os.path.join(os.environ["AGENT_STATE_DIR"], "environment")

# "podman run" con un tag gia' presente in locale NON lo riscarica da solo.
agent.run_helper("podman", "pull", app_image)

agent.run_helper(
    "podman", "run", "--rm",
    "--env-file", state_env_file,
    "--network", "sentinel-net",
    app_image,
    "node", "docker/migrate.mjs",
)
agent.run_helper(
    "podman", "run", "--rm",
    "--env-file", state_env_file,
    "--network", "sentinel-net",
    app_image,
    "node", "docker/bootstrap-admin.mjs",
)

route_response = agent.tasks.run(
    agent_id=agent.resolve_agent_id("traefik@node"),
    action="set-route",
    data={
        "instance": os.environ["MODULE_ID"],
        "url": f"http://127.0.0.1:{tcp_port}",
        "host": domain,
        "http2https": True,
        "lets_encrypt": True,
    },
)
agent.assert_exp(route_response["exit_code"] == 0)

print(json.dumps({"status": "ok", "domain": domain, "tcp_port": tcp_port}))
