{
    "$schema": "http://json-schema.org/draft-07/schema#",
    "title": "get-configuration output",
    "$id": "http://schema.nethserver.org/sentinel-fornitori/get-configuration-output.json",
    "description": "Configurazione corrente dell'installazione SENTINEL Fornitori (nessun segreto incluso)",
    "examples": [
        {
            "domain": "fornitori.cliente.it",
            "customer_name": "Azienda Cliente S.r.l.",
            "installation_id": "cliente-prod-01",
            "admin_email": "admin@cliente.it",
            "app_version": "1.0.0"
        }
    ],
    "type": "object",
    "properties": {
        "domain": { "type": "string" },
        "customer_name": { "type": "string" },
        "installation_id": { "type": "string" },
        "admin_email": { "type": "string" },
        "app_version": { "type": "string" }
    },
    "required": ["domain"],
    "additionalProperties": false
}
