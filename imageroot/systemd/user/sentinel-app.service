[Unit]
Description=SENTINEL Fornitori - applicazione principale
After=sentinel-postgres.service sentinel-minio.service sentinel-clamav.service
Wants=sentinel-postgres.service sentinel-minio.service sentinel-clamav.service

[Service]
Environment=PODMAN_SYSTEMD_UNIT=%n
EnvironmentFile=%S/state/environment
WorkingDirectory=%S/state
Restart=always
ExecStartPre=/usr/bin/podman network create --ignore sentinel-net
ExecStartPre=/bin/rm -f %t/sentinel-app.pid %t/sentinel-app.ctr-id
ExecStart=/usr/bin/podman run --conmon-pidfile %t/sentinel-app.pid \
    --cidfile %t/sentinel-app.ctr-id \
    --cgroups=no-conmon \
    --replace --name sentinel-app -d \
    --pull=newer \
    --network sentinel-net \
    --network-alias app \
    --env-file=%S/state/environment \
    --read-only \
    --tmpfs /tmp:size=128m,mode=1777 \
    --security-opt no-new-privileges \
    --publish 127.0.0.1:${TCP_PORT}:3000 \
    ${SENTINEL_FORNITORI_APP_IMAGE}
ExecStartPost=/bin/bash -c 'for i in $(seq 1 30); do curl -fsS http://127.0.0.1:${TCP_PORT}/api/health && exit 0; sleep 1; done; exit 1'
PIDFile=%t/sentinel-app.pid
Type=forking

[Install]
WantedBy=default.target
