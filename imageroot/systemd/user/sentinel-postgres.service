[Unit]
Description=SENTINEL Fornitori - PostgreSQL

[Service]
Environment=PODMAN_SYSTEMD_UNIT=%n
EnvironmentFile=%S/state/environment
WorkingDirectory=%S/state
Restart=always
ExecStartPre=/bin/rm -f %t/sentinel-postgres.pid %t/sentinel-postgres.ctr-id
ExecStart=/usr/bin/podman run --conmon-pidfile %t/sentinel-postgres.pid \
    --cidfile %t/sentinel-postgres.ctr-id \
    --cgroups=no-conmon \
    --replace --name sentinel-postgres -d \
    --env POSTGRES_DB=${POSTGRES_DB} \
    --env POSTGRES_USER=${POSTGRES_USER} \
    --env POSTGRES_PASSWORD=${POSTGRES_PASSWORD} \
    --volume sentinel-postgres-data:/var/lib/postgresql/data:Z \
    --publish 127.0.0.1:${POSTGRES_TCP_PORT}:5432 \
    ${POSTGRES_IMAGE}
ExecStartPost=/usr/local/bin/runagent wait-postgres-ready
ExecStop=/usr/bin/podman stop --ignore --cidfile %t/sentinel-postgres.ctr-id -t 10
ExecStopPost=/usr/bin/podman rm --ignore -f --cidfile %t/sentinel-postgres.ctr-id
PIDFile=%t/sentinel-postgres.pid
Type=forking

[Install]
WantedBy=default.target
