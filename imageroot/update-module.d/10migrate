#!/bin/bash
#
# Script eseguito dall'azione core update-module (in ordine alfabetico tra
# tutti gli script presenti in imageroot/update-module.d/).
#
# Applica le migrazioni idempotenti del database prima di riavviare
# l'applicazione, replicando quanto faceva docker/migrate.mjs nello stack
# Docker Compose originale.

set -euo pipefail

source "${AGENT_STATE_DIR:-.}/environment" 2>/dev/null || true

echo "Riavvio i servizi del modulo SENTINEL Fornitori..."
systemctl --user daemon-reload
systemctl --user restart sentinel-postgres.service
systemctl --user restart sentinel-minio.service
systemctl --user restart sentinel-clamav.service

echo "Applico le migrazioni database (docker/migrate.mjs incluso nell'immagine app)..."
podman run --rm \
    --env-file="${AGENT_STATE_DIR:-.}/environment" \
    --network=container:sentinel-postgres \
    "${SENTINEL_FORNITORI_APP_IMAGE}" node docker/migrate.mjs

echo "Riavvio l'applicazione..."
systemctl --user restart sentinel-app.service
