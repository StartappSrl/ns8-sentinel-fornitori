#!/bin/bash
set -euo pipefail

source "${AGENT_STATE_DIR:-.}/environment" 2>/dev/null || true

echo "Riavvio i servizi del modulo SENTINEL Fornitori..."
systemctl --user daemon-reload
systemctl --user restart sentinel-postgres.service
systemctl --user restart sentinel-minio.service
systemctl --user restart sentinel-clamav.service

echo "Scarico l'immagine app aggiornata..."
podman pull "${SENTINEL_FORNITORI_APP_IMAGE}"

echo "Applico le migrazioni database..."
podman run --rm \
    --env-file="${AGENT_STATE_DIR:-.}/environment" \
    --network=sentinel-net \
    "${SENTINEL_FORNITORI_APP_IMAGE}" node docker/migrate.mjs

echo "Riavvio l'applicazione..."
systemctl --user restart sentinel-app.service
